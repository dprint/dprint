{%
  set guide = [
    ["Overview", "/overview"],
    ["Install", "/install"],
    ["Setup", "/setup"],
    ["Configuration", "/config"],
    ["Global Configuration", "/global-config"],
    ["CLI", "/cli"],
    ["Language Server", "/lsp"],
    ["Continuous Integration", "/ci"]
  ]
%}

<div class="doc-menu-label">Guide</div>
<ul class="doc-menu">
  {% for item in guide %}
    <li><a href="{{ item[1] }}" {% if url == item[1] + "/" %}class="active"{% endif %}>{{ item[0] }}</a></li>
  {% endfor %}
</ul>
