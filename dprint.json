{
  "indentWidth": 2,
  "lineWidth": 160,
  "exec": {
    "cwd": "${configDir}",
    "commands": [{
      "command": "rustfmt --edition 2024 --config imports_granularity=item",
      "exts": ["rs"]
    }]
  },
  "malva": {
    "blockSelectorLinebreak": "always"
  },
  "excludes": [
    "website/playground/dist",
    "website/_site",
    "**/node_modules",
    "**/dist",
    "**/target",
    "**/*-lock.json"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.99.1",
    "npm:@dprint/json@0.26.0",
    "npm:@dprint/markdown@0.29.0",
    "npm:@dprint/toml@0.10.0",
    "npm:@dprint/exec@0.9.0/plugin.json@d4f708dc00798b51013ca4e7c26a86656bfb31e7255cdcde28a487f86813e34d",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.6",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/dockerfile@0.8.0"
  ]
}
